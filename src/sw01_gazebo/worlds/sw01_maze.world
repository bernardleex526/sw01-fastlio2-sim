<model name="wall_h08"><static>true</static><pose>5 4 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>10 0.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 0.2 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
<model name="wall_v06"><static>true</static><pose>4 -6 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 8 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 8 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
<model name="wall_v07"><static>true</static><pose>4 9 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 8 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 8 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
