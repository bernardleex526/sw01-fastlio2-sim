<model name="wall_h11"><static>true</static><pose>12 10 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2 0.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>2 0.2 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
<model name="wall_v08"><static>true</static><pose>10 -7 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 6 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 6 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
<model name="wall_v09"><static>true</static><pose>10 4 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 10 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 10 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>

    <!-- 起点 (-12,-12) 用 2 m 绿色薄板标出；终点 (12,12) 用同尺寸蓝色薄板标出，z=0.006 避免与地面 z-fighting。 -->
    <model name="start_zone"><static>true</static><pose>-12 -12 0.006 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2 2 0.01</size></box></geometry></collision><visual name="visual"><geometry><box><size>2 2 0.01</size></box></geometry><material><diffuse>0 1 0 1</diffuse></material></visual></link></model>
    <model name="goal_zone"><static>true</static><pose>12 12 0.006 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2 2 0.01</size></box></geometry></collision><visual name="visual"><geometry><box><size>2 2 0.01</size></box></geometry><material><diffuse>0 0 1 1</diffuse></material></visual></link></model>
  </world>
</sdf>
