<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="sw01_maze">
    <!-- 设计规范固定的物理与环境光：重力为 (0,0,-9.8)，ambient=(0.8,0.8,0.8,1) 让封闭迷宫不依赖联网纹理也清晰可见。 -->
    <gravity>0 0 -9.8</gravity>
    <scene><ambient>0.8 0.8 0.8 1</ambient></scene>
    <!-- directional sun 位于 (0,0,10)、方向为 (-0.5,0.1,-0.9) 提供整体照明；point light 位于 (0,0,12)、range=40，消除迷宫内部暗角。 -->
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>
    <light name="maze_point_light" type="point"><pose>0 0 12 0 0 0</pose><cast_shadows>false</cast_shadows><diffuse>0.6 0.6 0.6 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>40</range><constant>0.7</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation></light>

    <!-- 30.4 m 的 concrete ground 覆盖 30 m 可用区；厚 0.1 m、中心 z=-0.05，使顶面恰好是 z=0。 -->
    <model name="ground"><static>true</static><pose>0 0 -0.05 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>30.4 30.4 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>30.4 30.4 0.1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Concrete</name></script><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>

    <!-- 边界墙围住 [-15,15] m；所有墙厚 0.2 m、高 1.5 m，故墙体中心统一置于 z=0.75 m。 -->
    <model name="wall_b_n"><static>true</static><pose>0 15 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>30.2 0.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>30.2 0.2 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
    <model name="wall_b_s"><static>true</static><pose>0 -15 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>30.2 0.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>30.2 0.2 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
    <model name="wall_b_e"><static>true</static><pose>15 0 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 30.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 30.2 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
    <model name="wall_b_w"><static>true</static><pose>-15 0 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 30.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 30.2 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>

    <!-- 8.2 节批准的 H/V 墙表：保留 T/十字分支及至少 2 m 开口。导航检查会把这些真实 collision box 按 0.50 m 膨胀后验证起终点连通和路口数量。 -->
    <model name="wall_h01"><static>true</static><pose>-8 -10 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>10 0.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 0.2 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
<model name="wall_h02"><static>true</static><pose>4 -10 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>8 0.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>8 0.2 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
<model name="wall_h03"><static>true</static><pose>11.5 -10 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>3 0.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>3 0.2 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
<model name="wall_v01"><static>true</static><pose>-8 -6.5 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 7 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 7 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
<model name="wall_v02"><static>true</static><pose>-8 5 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 14 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 14 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
<model name="wall_h04"><static>true</static><pose>-11 -2 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 0.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 0.2 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
<model name="wall_h05"><static>true</static><pose>-2.5 -2 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>9 0.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>9 0.2 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
<model name="wall_h06"><static>true</static><pose>9 -2 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>8 0.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>8 0.2 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
<model name="wall_v03"><static>true</static><pose>-2 -8 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 4 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
<model name="wall_v04"><static>true</static><pose>-2 4.5 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 11 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 11 1.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link></model>
