  <joint name="base_to_imu" type="fixed">
    <origin xyz="0.0065429535 -0.0050846333 0.016924295" rpy="0 0 0"/>
    <parent link="base_link"/><child link="imu_link"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1.158333E-04" ixy="0" ixz="0" iyy="1.158333E-04" iyz="0" izz="1.25E-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
      <material name="lidar_black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
    </collision>
  </link>
  <!-- 雷达坐标采用仿真设计审定的背部安装位：相对 base_link 后移 0.08 m、上移 0.48 m。 -->
  <joint name="base_to_lidar" type="fixed">
    <origin xyz="-0.08 0 0.48" rpy="0 0 0"/>
    <parent link="base_link"/><child link="lidar_link"/>
  </joint>

  <!--
    Velodyne 参数源自 FAST-LIO2 的 VELO16 输入契约：话题 /velodyne_points，坐标系 lidar_link。
    10 Hz、900×16 采样、水平 ±π、垂直 ±0.261799 rad、0.30～35.0 m 量程及 0.01 m 高斯噪声均为审定仿真值；
    Humble velodyne_gazebo_plugins 的 organize_cloud=false 会剔除无效射线，同时为有效点保留 x/y/z/intensity/ring/time 字段；
    这可避免有序点云的 NaN 占位污染本地 FAST-LIO2 在有限值过滤前执行的逐 ring 首点时间合成。
  -->
  <gazebo reference="lidar_link">
    <sensor name="sw01_velodyne" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>900</samples><resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples><resolution>1</resolution>
            <min_angle>-0.261799</min_angle><max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range><min>0.30</min><max>35.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="sw01_velodyne_plugin" filename="libgazebo_ros_velodyne_laser.so">
        <ros><remapping>~/out:=/velodyne_points</remapping></ros>
        <topicName>/velodyne_points</topicName>
        <frameName>lidar_link</frameName>
        <min_range>0.30</min_range><max_range>35.0</max_range>
        <gaussianNoise>0.01</gaussianNoise>
        <organize_cloud>false</organize_cloud>
      </plugin>
    </sensor>
  </gazebo>

  <!--
    IMU 参数源自 FAST-LIO2 接口契约：话题 /imu/data，消息坐标系 body，更新率 200 Hz。
    body 有意不定义为 URDF link，以免与 FAST-LIO2 的 camera_init 到 body 变换形成重复父节点；
    三轴角速度与加速度噪声标准差分别为 2e-4 rad/s 和 1.7e-3 m/s²。
  -->
  <gazebo reference="imu_link">
    <sensor name="sw01_imu" type="imu">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>200</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="sw01_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros><remapping>~/out:=/imu/data</remapping></ros>
        <frame_name>body</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <!--
      P3D 仅提供评估真值：/ground_truth/odom 以 world 为参考坐标系、跟踪 base_link，更新率 50 Hz；
      零附加噪声便于与 SLAM 轨迹对比，该话题不接入 FAST-LIO2、slam_toolbox 或 Nav2。
    -->
    <plugin name="sw01_ground_truth" filename="libgazebo_ros_p3d.so">
      <ros><remapping>odom:=/ground_truth/odom</remapping></ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>50</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
    <!--
      Planar Move 接收 Nav2 的 /cmd_vel，在 base_link 的 xy 和 yaw 平面以 50 Hz 驱动模型；
      关闭里程计、odom TF 和轮 TF，避免与 FAST-LIO2 发布的定位与坐标变换冲突。
    -->
    <plugin name="sw01_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros><remapping>cmd_vel:=/cmd_vel</remapping></ros>
      <command_topic>/cmd_vel</command_topic>
      <odometry_topic>/unused_planar_odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <update_rate>50</update_rate>
      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </gazebo>
</robot>
